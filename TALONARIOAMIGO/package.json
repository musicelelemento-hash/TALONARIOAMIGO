{
  "name": "talonario-amigo",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend SPA de Talonario Amigo (módulos ES vanilla). Se sirve desde el backend Laravel y se empaqueta con Capacitor para Android.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "sync:mobile": "node scripts/sync_mobile.mjs",
    "build:mobile": "npm run build && node scripts/sync_mobile.mjs",
    "lint": "eslint resources/js",
    "test:js": "node --test tests/js/*.test.mjs",
    "format": "prettier --write resources/js",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1"
  }
}
