# ============================================================
# Talonario Amigo — Plantilla de entorno
# Copia este archivo a .env y completa los valores.
#   cp .env.example .env
#   php artisan key:generate
# ============================================================

APP_NAME=TalonarioAmigo
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ------------------------------------------------------------
# Base de datos
# Local (demo rápido): SQLite. Producción: PostgreSQL / Supabase.
# ------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_DATABASE=/ruta/absoluta/database/database.sqlite

# Para Supabase/PostgreSQL (producción):
# DB_CONNECTION=pgsql
# DB_HOST=db.<tu-proyecto>.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=

# ------------------------------------------------------------
# Librería firmadora SRI (Facturación electrónica Ecuador)
# La emisión usa el .p12 del emisor logueado; estos valores
# cubren SOAP, ambiente e infraestructura.
#   FACTURACION_AMBIENTE: 1 = Pruebas · 2 = Producción
# ------------------------------------------------------------
FACTURACION_AMBIENTE=1
FACTURACION_SOAP_TIMEOUT=30
FACTURACION_CA_FILE=

# ------------------------------------------------------------
# Soporte / WhatsApp de mostrador
# ------------------------------------------------------------
DEFAULT_SUPPORT_WHATSAPP=593993050689

# ------------------------------------------------------------
# Factura por WhatsApp (WhatsApp Cloud API de Meta) — ver docs/WHATSAPP_SETUP.md
# ------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto que tú inventas; Meta lo envía al verificar el webhook.
WHATSAPP_VERIFY_TOKEN=
# "App secret" de la app de Meta: valida la firma X-Hub-Signature-256 de cada mensaje.
WHATSAPP_APP_SECRET=
# Número del bot, solo dígitos (ej. 593980000000), para el botón "Enviar por WhatsApp".
WHATSAPP_BOT_NUMBER=

# ------------------------------------------------------------
# CORS — orígenes permitidos (separados por coma). NO deixar '*'.
# ------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://talonarioamigo.com,http://localhost:8000,http://localhost:5173

# ------------------------------------------------------------
# Almacenamiento Supabase Storage (bóveda de XML/RIDE)
# SUPABASE_SERVICE_ROLE_KEY es la clave "service_role" del panel
# (Settings → API). Va solo en el backend, NUNCA en el navegador.
# ------------------------------------------------------------
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=talonario-amigo-vault

# ------------------------------------------------------------
# Email (Resend) para envío de XML/RIDE
# ------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="Talonario Amigo"

# ------------------------------------------------------------
# Seeder de cuenta maestra e imprenta reseller
# (obligatorio para SuperAdminSeeder)
# ------------------------------------------------------------
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME="Dueño Talonario Amigo"
SEED_RESELLER_EMAIL=
SEED_RESELLER_NAME="Imprenta Reseller"
SEED_RESELLER_PASSWORD=
SEED_RESELLER_PHONE=

# ------------------------------------------------------------
# Datos de demostración (DemoSeeder) — historial de ejemplo
# ------------------------------------------------------------
SEED_DEMO_EMAIL=demo@talonarioamigo.com
SEED_DEMO_PASSWORD=demo
