APP_NAME="Talonario Amigo Ecuador"
APP_ENV=production
APP_KEY=base64:e1sMEij+daFa6GVHd9ldMpB/mMpZ5obe3n5fvD2HAhM=
APP_DEBUG=false
APP_URL=https://talonario-amigo-api.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

# En Render la conexión real la inyecta render.yaml (Postgres gestionado).
# pgsql es el motor correcto; estos valores sirven para referencia local.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=talonario_amigo_prod
DB_USERNAME=talonario_user
DB_PASSWORD=secret_production_pass

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Librería firmadora SRI (la emisión usa el .p12 del emisor logueado;
# estos valores cubren SOAP/ambiente/envío).
FACTURACION_CERTIFICADO_P12=
FACTURACION_CERTIFICADO_CLAVE=
FACTURACION_AMBIENTE=1
FACTURACION_CA_FILE=
FACTURACION_SOAP_TIMEOUT=30

DEFAULT_SUPPORT_WHATSAPP=593993050689
SANCTUM_STATEFUL_DOMAINS=talonarioamigo.com,www.talonarioamigo.com,talonario-amigo-api.onrender.com

