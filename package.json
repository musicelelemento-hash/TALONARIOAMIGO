{
  "name": "talonario-amigo-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo de Talonario Amigo (Backend Laravel + SPA Vite + App Móvil Capacitor + Cloudflare Workers)",
  "workspaces": [
    "TALONARIOAMIGO"
  ],
  "scripts": {
    "dev": "npm run dev --prefix TALONARIOAMIGO",
    "build": "npm run build --prefix TALONARIOAMIGO",
    "sync:mobile": "npm run sync:mobile --prefix TALONARIOAMIGO",
    "build:mobile": "npm run build:mobile --prefix TALONARIOAMIGO",
    "open:android": "npm run open:android --prefix talonario-amigo-mobile",
    "desktop": "npm run start --prefix talonario-amigo-desktop",
    "lint": "npm run lint --prefix TALONARIOAMIGO"
  }
}
